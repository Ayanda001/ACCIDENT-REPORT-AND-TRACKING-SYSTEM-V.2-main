<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:background="@color/bg_secondary">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/accent_green"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Emergency Helplines" android:textColor="@color/text_primary"
            android:textSize="17sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EMERGENCY" android:textColor="@color/alert_red"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Emergency (Any Network)" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Police, ambulance, fire - free call" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_112" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="112"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SAPS Police" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="South African Police Service" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_10111" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10111"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ambulance / EMS" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Emergency medical services" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_10177" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10177"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SUPPORT" android:textColor="@color/accent_green"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1"
                android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AA Emergency Rescue" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Automobile Association" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_17737" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="17737"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Childline South Africa" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="24-hour child emergency helpline" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_0800012322" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0800012322"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Traffic Department" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Road and traffic enquiries" android:textColor="@color/text_hint" android:textSize="12sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btn_call_traffic" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0861400800"
                        android:backgroundTint="@color/accent_green" android:textColor="@color/white"
                        android:textSize="14sp" android:paddingHorizontal="18dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
